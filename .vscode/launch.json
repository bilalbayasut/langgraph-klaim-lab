{
  // VS Code debugger for this lab. Set a breakpoint in app/*.py and press F5.
  // Needs the "Python" extension (ms-python.python) and the .venv interpreter (Ctrl+Shift+P > Python: Select Interpreter).
  "version": "0.2.0",
  "configurations": [
    {
      "name": "app.py: run the graph",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "args": ["${input:request}"],
      "cwd": "${workspaceFolder}",
      "env": {"LLM_MODE": "mock"},
      "justMyCode": true,
      "console": "integratedTerminal"
    },
    {
      "name": "app.py: resume a thread",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "args": ["--thread", "${input:thread}", "--resume", "${input:action}"],
      "cwd": "${workspaceFolder}",
      "env": {"LLM_MODE": "mock"},
      "justMyCode": true,
      "console": "integratedTerminal"
    },
    {
      "name": "pytest: tests of step N",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests/test_step${input:step}.py", "-x"],
      "cwd": "${workspaceFolder}",
      "justMyCode": true,
      "console": "integratedTerminal"
    }
  ],
  "inputs": [
    {"id": "request", "type": "promptString", "description": "Request", "default": "Process claim CLM-001"},
    {"id": "thread", "type": "promptString", "description": "thread_id", "default": "t1"},
    {"id": "action", "type": "pickString", "description": "Manager answer", "options": ["approve", "revise", "reject"], "default": "approve"},
    {"id": "step", "type": "promptString", "description": "Step number (two digits, e.g. 05)", "default": "01"}
  ]
}
