{
  // Debugger VS Code untuk lab ini. Pasang breakpoint di app/*.py lalu tekan F5.
  // Butuh ekstensi "Python" (ms-python.python) dan interpreter .venv (Ctrl+Shift+P > Python: Select Interpreter).
  "version": "0.2.0",
  "configurations": [
    {
      "name": "app.py: jalankan graph",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "args": ["${input:permintaan}"],
      "cwd": "${workspaceFolder}",
      "env": {"LLM_MODE": "mock"},
      "justMyCode": true,
      "console": "integratedTerminal"
    },
    {
      "name": "app.py: lanjutkan thread (resume)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "args": ["--thread", "${input:thread}", "--lanjut", "${input:aksi}"],
      "cwd": "${workspaceFolder}",
      "env": {"LLM_MODE": "mock"},
      "justMyCode": true,
      "console": "integratedTerminal"
    },
    {
      "name": "pytest: test langkah N",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests/test_langkah${input:langkah}.py", "-x"],
      "cwd": "${workspaceFolder}",
      "justMyCode": true,
      "console": "integratedTerminal"
    }
  ],
  "inputs": [
    {"id": "permintaan", "type": "promptString", "description": "Permintaan", "default": "Proses klaim KLM-001"},
    {"id": "thread", "type": "promptString", "description": "thread_id", "default": "t1"},
    {"id": "aksi", "type": "pickString", "description": "Jawaban atasan", "options": ["setujui", "revisi", "tolak"], "default": "setujui"},
    {"id": "langkah", "type": "promptString", "description": "Nomor langkah (dua digit, misal 05)", "default": "01"}
  ]
}
