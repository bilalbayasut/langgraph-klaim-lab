# Copy to .env:  cp .env.example .env
# Never commit the .env file.

# mock = no LLM (deterministic, free, good for tests and debugging)
# live = call an LLM through an OpenAI-compatible endpoint (Step 5)
LLM_MODE=mock

# OpenAI-compatible endpoint. Examples:
#   Sumopod      : https://ai.sumopod.com/v1           (model: glm-5.3-flash)
#   local vLLM   : http://127.0.0.1:8000/v1            (model: same as --served-model-name)
#   Ollama       : http://127.0.0.1:11434/v1           (model: qwen3:4b, any api key)
LLM_BASE_URL=https://ai.sumopod.com/v1
LLM_API_KEY=
LLM_MODEL=glm-5.3-flash
LLM_TEMPERATURE=0

# Embedding for ChromaDB (Step 8):
#   hash = deterministic fake embedding (HashingVectorizer), no internet. Default.
#   onnx = ChromaDB's built-in all-MiniLM-L6-v2 model (downloaded once, ~80 MB).
EMBEDDING=hash

# MCP server HR/Finance (Step 7). Empty = stdio: the agent starts mcp_server/hr_finance.py itself.
# Filled = Streamable HTTP to a server that is already running, e.g. http://127.0.0.1:8001/mcp
MCP_HR_FINANCE_URL=

# Safety limit for the evaluator-optimizer loop (Step 12)
MAX_REVISIONS=2

# Location of the SQLite checkpoints, the ChromaDB index, and the fake payment ledger
RUNTIME_DIR=./runtime

# Simulations for the exercises (keep 0 in normal use)
HR_FAIL_TIMES=0
CRASH_AFTER_PAYMENT=0
MOCK_FIRST_DRAFT_INCOMPLETE=1

# Tracing with LangSmith (Step 18). Create a key at https://smith.langchain.com, then set to true.
# Note: run inputs/outputs ARE SENT to the LangSmith server (see Step 22 about sensitive data).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=claim-lab
