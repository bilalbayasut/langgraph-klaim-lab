# Salin menjadi .env:  cp .env.example .env
# Jangan commit file .env.

# mock = tanpa LLM (deterministik, gratis, cocok untuk test dan debugging di Studio)
# live = memanggil LLM lewat endpoint OpenAI-compatible
LLM_MODE=mock

# Endpoint OpenAI-compatible. Contoh:
#   Sumopod      : https://ai.sumopod.com/v1           (model: glm-5.3-flash)
#   vLLM lokal   : http://127.0.0.1:8000/v1            (model: sesuai --served-model-name)
#   Ollama       : http://127.0.0.1:11434/v1           (model: qwen3:4b, api key bebas)
LLM_BASE_URL=https://ai.sumopod.com/v1
LLM_API_KEY=
LLM_MODEL=glm-5.3-flash
LLM_TEMPERATURE=0

# Pengaman loop evaluator-optimizer
MAX_REVISI=2

# Lokasi checkpoint SQLite dan buku besar pembayaran tiruan
RUNTIME_DIR=./runtime

# Simulasi untuk latihan (biarkan 0 / kosong saat normal)
HR_GAGAL_N_KALI=0
CRASH_SETELAH_BAYAR=0
MOCK_DRAF_PERTAMA_KURANG=1
